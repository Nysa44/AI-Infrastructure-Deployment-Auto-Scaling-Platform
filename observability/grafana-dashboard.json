{
  "id": null,
  "uid": "ai-inference-platform",
  "title": "AI Inference Platform",
  "tags": [
    "devops",
    "inference"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Jobs submitted / processed / failed",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(inference_jobs_submitted_total[5m]))",
          "legendFormat": "submitted"
        },
        {
          "expr": "sum(rate(inference_jobs_processed_total[5m]))",
          "legendFormat": "processed"
        },
        {
          "expr": "sum(rate(inference_jobs_failed_total[5m]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue depth",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "inference_queue_depth",
          "legendFormat": "queue depth"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 processing latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum(rate(inference_job_processing_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 seconds"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Retries and DLQ",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(inference_worker_retries_total[5m]))",
          "legendFormat": "retries/s"
        },
        {
          "expr": "sum(rate(inference_dead_letter_total[5m]))",
          "legendFormat": "DLQ/s"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}